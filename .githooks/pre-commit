#!/usr/bin/env bash
set -euo pipefail

# ThoughtEcho Pre-Commit Guard
# Enabled via: git config core.hooksPath .githooks

# 1. Block accidental staging of local device info or API secret patterns.
# `grep -cE` reads stdin through EOF before exiting, avoiding early pipe close
# SIGPIPE (141) misfires under `set -euo pipefail`.
DEVICE_INFO_MATCHES=$(
  git -c core.quotePath=false diff --cached --name-only |
    { grep -cE '(^|/)DEVICE_INFO\.md$' || [ "$?" -eq 1 ]; }
)
if [ "$DEVICE_INFO_MATCHES" -gt 0 ]; then
  echo "❌ [pre-commit] Blocked: DEVICE_INFO.md is machine-local and must not be committed." >&2
  exit 1
fi

SECRET_MATCHES=$(
  git -c core.quotePath=false diff --cached -U0 |
    { grep -cE '^\+([^+].*)?(sk-[A-Za-z0-9]{20,}|sntrys_[A-Za-z0-9_]{20,}|ghp_[A-Za-z0-9]{20,})' || [ "$?" -eq 1 ]; }
)
if [ "$SECRET_MATCHES" -gt 0 ]; then
  echo "❌ [pre-commit] Blocked: Potential API key or secret token detected in staged changes." >&2
  exit 1
fi

# 2. Check formatting and mechanical repository rules on staged changes
STAGED_DART_FILES=()
while IFS= read -r -d '' file; do
  STAGED_DART_FILES+=("$file")
done < <(git -c core.quotePath=false diff --cached --name-only -z --diff-filter=ACMR -- '*.dart')

if command -v dart >/dev/null 2>&1; then
  if [ "${#STAGED_DART_FILES[@]}" -gt 0 ]; then
    # Verify formatting of staged Dart files
    dart format --output=none --set-exit-if-changed "${STAGED_DART_FILES[@]}"
  fi
  # Verify mechanical UI/architecture/API/naming rules on staged changes
  dart scripts/lint_repo_rules.dart --staged
fi
