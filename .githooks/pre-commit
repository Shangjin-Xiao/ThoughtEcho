#!/usr/bin/env bash
set -euo pipefail

# ThoughtEcho Pre-Commit Guard
# Enabled via: git config core.hooksPath .githooks

STAGED_DART_FILES=$(git diff --cached --name-only --diff-filter=ACMR -- '*.dart' || true)

# 1. Block accidental staging of local device info or API secret patterns
if git diff --cached --name-only | grep -qE '(^|/)DEVICE_INFO\.md$'; then
  echo "❌ [pre-commit] Blocked: DEVICE_INFO.md is machine-local and must not be committed." >&2
  exit 1
fi

if git diff --cached -U0 | grep -E '^\+[^+]' | grep -qE '(sk-[A-Za-z0-9]{20,}|sntrys_[A-Za-z0-9_]{20,}|ghp_[A-Za-z0-9]{20,})'; then
  echo "❌ [pre-commit] Blocked: Potential API key or secret token detected in staged changes." >&2
  exit 1
fi

# 2. Check formatting and mechanical repository rules on staged Dart changes
if [ -n "$STAGED_DART_FILES" ]; then
  if command -v dart >/dev/null 2>&1; then
    # Verify formatting of staged Dart files
    echo "$STAGED_DART_FILES" | xargs dart format --output=none --set-exit-if-changed
    # Verify mechanical UI/architecture/API rules on staged added lines
    dart scripts/lint_repo_rules.dart --staged
  fi
fi
